# SocialHub Backend Environment Configuration

# MongoDB Connection URI
# Local development (default)
MONGODB_URI=mongodb://localhost:27017/socialhub

# Alternative MongoDB configurations
# For production or remote MongoDB:
# MONGODB_URI=mongodb://username:password@host:port/socialhub
# MONGODB_URI=mongodb+srv://cluster-name.mongodb.net/socialhub

# Server Configuration
SERVER_PORT=8080

# Application Profile (local, dev, prod)
SPRING_PROFILES_ACTIVE=local

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_COM_SOCIALHUB=DEBUG

# JWT Configuration (for future use)
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Email Configuration (for future notifications)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-email-password

# Optional: Additional Security
# HTTPS_ENABLED=false
